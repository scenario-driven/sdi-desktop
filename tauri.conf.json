{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDI",
  "version": "0.1.0",
  "identifier": "org.sdi.desktop",
  "build": {
    "frontendDist": "../sdi-web/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm --dir ../sdi-web dev",
    "beforeBuildCommand": "pnpm --dir ../sdi-web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SDI",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
